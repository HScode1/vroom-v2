PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT secret for admin authentication (change in production!)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Admin credentials (change in production!)
ADMIN_EMAIL=admin@vroomparis.fr
ADMIN_PASSWORD=Vroom2026!

# Supabase (required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket name (create it in Supabase Dashboard > Storage)
SUPABASE_STORAGE_BUCKET=vehicles

# Max upload size per file
MAX_FILE_SIZE_MB=10
