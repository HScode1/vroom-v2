PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT secret for admin authentication (change in production!)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Admin credentials (change in production!)
ADMIN_EMAIL=admin@vroomparis.fr
ADMIN_PASSWORD=Vroom2026!

# Supabase (required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket name (create it in Supabase Dashboard > Storage)
SUPABASE_STORAGE_BUCKET=vehicles

# Email notifications (Resend)
RESEND_API_KEY=re_xxxxx
TEAM_EMAIL=contact@vroomparis.fr
EMAIL_FROM="VroomAdvisor <reservations@vroomparis.fr>"

# Max upload size per file
MAX_FILE_SIZE_MB=10

# Google Calendar integration
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_TIME_ZONE=Europe/Paris
